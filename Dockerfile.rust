# Use the same base image as the original project to ensure compatibility with libs
FROM ubuntu:24.04 AS base_builder

# Install dependencies including Rust and RISC-V toolchain
RUN apt update && apt install -y \
    wget \
    curl \
    git \
    cmake \
    pkg-config \
    libssl-dev \
    build-essential \
    gcc-riscv64-linux-gnu \
    g++-riscv64-linux-gnu \
    musl-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install RISC-V target for Rust
RUN rustup target add riscv64gc-unknown-linux-gnu

WORKDIR /app

# Copy the entire project context (NanoKVM + nanokvm-rs)
COPY . .

# Set up the library search path for the proprietary libs
ENV RUSTFLAGS="-C linker=riscv64-linux-gnu-gcc -L /app/NanoKVM/server/dl_lib"
# Both dash and underscore variants for CC/CXX to be safe
ENV CC_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-gcc
ENV CXX_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-g++
ENV CC_riscv64gc-unknown-linux-gnu=riscv64-linux-gnu-gcc
ENV CXX_riscv64gc-unknown-linux-gnu=riscv64-linux-gnu-g++
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV OPENSSL_STATIC=1

# Switch to the Rust workspace directory
WORKDIR /app/nanokvm-rs

# Attempt to build the server
CMD ["cargo", "build", "--release", "--target", "riscv64gc-unknown-linux-gnu"]